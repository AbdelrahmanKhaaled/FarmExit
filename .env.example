# Local MySQL for docker-compose.yml. Copy to .env (never commit .env) and choose your own passwords.
# The API connection strings live in api/.env (see api/.env.example) and must use the same user/password.
# On first `npm run db:up`, docker/mysql/init creates the farmexit_shadow database for Prisma Migrate.
MYSQL_DATABASE=farmexit
MYSQL_USER=farmexit
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3306
