# Local MySQL for docker-compose.yml. Copy to .env (never commit .env) and choose your own passwords.
# The API connection string lives in api/.env (see api/.env.example) and must use the same values.
MYSQL_DATABASE=farmexit
MYSQL_USER=farmexit
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3306
