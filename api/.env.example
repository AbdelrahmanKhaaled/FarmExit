# FarmExit API environment. Copy to api/.env (never commit .env).

# development | test | production
NODE_ENV=development
PORT=4000

# MySQL (Prisma URL format). Must match the MYSQL_* values in the root .env used by docker-compose.yml.
DATABASE_URL=mysql://farmexit:change-me@localhost:3306/farmexit

# Comma-separated browser origins allowed by CORS (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# Swagger UI at /api/docs. Defaults to true outside production and false in production.
SWAGGER_ENABLED=true
