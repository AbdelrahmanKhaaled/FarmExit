# FarmExit API environment. Copy to api/.env (never commit .env).

# development | test | production
NODE_ENV=development
PORT=4000

# MySQL (Prisma URL format). Laragon: use 127.0.0.1:3306.
DATABASE_URL=mysql://farmexit:change-me@127.0.0.1:3306/farmexit

# Prisma Migrate shadow DB for schema migrations. Must differ from DATABASE_URL.
SHADOW_DATABASE_URL=mysql://farmexit:change-me@127.0.0.1:3306/farmexit_shadow

# Auth secrets: required, no defaults, at least 32 characters, different from each other.
# Generate each with: openssl rand -base64 48   (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_ACCESS_SECRET=
OTP_HASH_SECRET=

# Optional auth tuning (defaults shown). JWT_ISSUER=farmexit-api
# ACCESS_TOKEN_TTL_SECONDS=900  REFRESH_TOKEN_TTL_DAYS=30
# OTP_TTL_SECONDS=300  OTP_RESEND_COOLDOWN_SECONDS=60  OTP_MAX_ATTEMPTS=5  OTP_MAX_REQUESTS_PER_HOUR=5
# SMS adapter. `development` only logs the OTP outside production and is refused when NODE_ENV=production.
SMS_PROVIDER=development

# Development-only fixed OTP (NODE_ENV=development only; refused in production when enabled).
DEV_FIXED_OTP_ENABLED=false
DEV_FIXED_OTP_CODE=
DEV_FIXED_OTP_ALLOWED_MOBILES=

# Comma-separated browser origins allowed by CORS (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Swagger UI at /api/docs. Defaults to true outside production and false in production.
SWAGGER_ENABLED=true

# Private image storage. local (dev/test only, refused in production) writes under MEDIA_STORAGE_DIR (git-ignored).
MEDIA_STORAGE_PROVIDER=local
# MEDIA_STORAGE_DIR=./storage/uploads
# MEDIA_MAX_IMAGE_BYTES=5242880
