{
  "name": "farmexit-api",
  "version": "0.1.0",
  "description": "FarmExit backend: NestJS REST API (MySQL via Prisma)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build && node -e \"require('fs').writeFileSync('dist/package.json',JSON.stringify({type:'commonjs'})+'\\n')\"",
    "start": "nest start --exec \"node ./scripts/run-dist-cjs.cjs\"",
    "start:dev": "nest start --watch --exec \"node ./scripts/run-dist-cjs.cjs\"",
    "start:debug": "nest start --debug --watch --exec \"node ./scripts/run-dist-cjs.cjs\"",
    "start:prod": "node ./scripts/run-dist-cjs.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest-integration.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:seed": "prisma db seed",
    "admin:bootstrap": "npx -y tsx prisma/admin-bootstrap.ts",
    "admin:bootstrap-super": "npx -y tsx prisma/super-admin-bootstrap.ts",
    "admin:provision-super": "npx -y tsx prisma/provision-super-admin.ts",
    "dev:fix-mobiles": "npx -y tsx prisma/fix-mobiles.ts",
    "seed:dashboard-demo": "npx -y tsx prisma/seed-dashboard-demo.ts",
    "seed:client-demo": "node scripts/seed-client-demo.cjs",
    "seed:public-farms-demo": "node scripts/seed-public-farms-demo.cjs",
    "seed:public-farms-demo:production": "node scripts/seed-public-farms-demo.cjs --production-server",
    "test:client-demo-safety": "node --test --test-isolation=none scripts/client-demo-safety.test.cjs",
    "verify:client-demo-browser": "node scripts/verify-client-demo-browser.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "^12.2.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.43.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "\\.integration-spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!generated/**",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "npx -y tsx prisma/seed.ts"
  }
}
