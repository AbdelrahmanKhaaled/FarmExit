{
  "name": "farmexit-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && node scripts/check-direction.mjs && node scripts/check-messages.mjs && node scripts/check-sidebar-motion.mjs && node scripts/check-session-readonly.mjs",
    "test:unit": "node --import tsx --test src/lib/admin/session-token.test.ts src/lib/admin/specialized-request-path.test.ts src/config/admin-navigation.test.ts src/features/admin/analytics/analytics-query.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
