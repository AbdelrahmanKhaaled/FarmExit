Project FarmExit_Final_Implementation {
  database_type: 'MySQL'
  Note: 'FarmExit updated logical ERD. FarmExit brokers introductions and mediates all buyer/renter-owner messaging. Sale/rent contracting, transfer and ALL payments happen OFF-PLATFORM. No payment, settlement, commission, online contract or binding online-offer execution modules. Optional admin-recorded off-platform outcomes are informational only. No global customer roles; farm roles are contextual. FarmExit Score is a STAFF evaluation, not a user rating. Evaluation methodology is not yet approved; publish only after documented evidence and review policy. Sale listings may be cash-only or quick-sale (open to installment and exchange proposals); co-purchase is buyer interest matching only. All negotiations, approvals, contracting, consideration and completion happen outside the website through FarmExit staff; there is no on-platform deal-closing workflow. Every datetime column is DATETIME(3) and stores UTC.'
}

// =========================
// IDENTITY & ACCESS
// =========================
Table users {
  id bigint [pk, increment]
  full_name varchar(150) [note: 'NULL until profile completion (phone -> OTP -> profile). profileCompleted = full_name is set.']
  mobile_e164 varchar(20) [unique, not null, note: 'Required for every account (E.164). Egyptian mobiles: +2010/11/12/15 + 8 digits.']
  mobile_verified_at datetime(3)
  email varchar(255) [unique]
  avatar_storage_key varchar(500)
  account_status varchar(30) [not null, default: 'active', note: 'active, suspended, blocked']
  last_login_at datetime(3)
  created_at datetime(3)
  updated_at datetime(3)
  Note: 'Single account. No global owner/buyer/renter/manager/engineer role column. Context is derived from farm relationships, professional capabilities and activity.'
}

Table user_sessions {
  id bigint [pk, increment]
  user_id bigint [not null]
  auth_audience varchar(20) [not null, default: 'website', note: 'website = mobile OTP; dashboard = admin email/password']
  session_token_hash varchar(128) [unique, not null]
  device_name varchar(120)
  user_agent text
  ip_address varchar(45)
  expires_at datetime(3) [not null]
  last_seen_at datetime(3)
  revoked_at datetime(3)
  created_at datetime(3)
  indexes {
    (user_id, revoked_at, expires_at)
  }
}

Table user_session_tokens {
  id bigint [pk, increment]
  session_id bigint [not null]
  token_hash varchar(128) [not null, note: 'SHA-256 of an already rotated refresh secret; proves replay']
  consumed_at datetime(3) [not null]
  indexes {
    (session_id, token_hash) [unique]
  }
}

Table otp_verifications {
  id bigint [pk, increment]
  user_id bigint
  mobile_e164 varchar(20) [not null]
  purpose varchar(30) [not null, note: 'sign_in, registration, verification']
  code_hash varchar(128) [not null]
  attempts int [not null, default: 0]
  expires_at datetime(3) [not null]
  consumed_at datetime(3)
  created_at datetime(3)
  indexes {
    (mobile_e164, purpose, created_at)
    (user_id, purpose, created_at)
  }
  Note: 'Never store the raw OTP. Resend timer is configurable; default UX is 60 seconds.'
}

Table staff_memberships {
  id bigint [pk, increment]
  user_id bigint [not null]
  staff_role varchar(40) [not null, note: 'super_admin, admin, case_agent, reviewer — platform staff, not farm business roles']
  status varchar(20) [not null, default: 'active']
  created_at datetime(3)
  indexes {
    (user_id, staff_role) [unique]
  }
}

Table admin_credentials {
  id bigint [pk, increment]
  user_id bigint [unique, not null]
  email varchar(255) [unique, not null, note: 'Canonical dashboard login email (lowercase)']
  password_hash varchar(255) [not null, note: 'Argon2id only; never plaintext']
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: true]
  password_changed_at datetime(3)
  failed_login_attempts int [not null, default: 0]
  locked_until datetime(3)
  last_login_at datetime(3)
  created_at datetime(3) [not null]
  updated_at datetime(3) [not null]
  Note: 'Optional 0..1 per user. Dashboard email/password for staff with admin or super_admin membership only.'
}

// =========================
// FARMS & FARM RELATIONSHIPS
// =========================
Table farms {
  id bigint [pk, increment]
  name varchar(200) [not null]
  description text
  farm_type varchar(40) [not null, note: 'Vegetable, Fruit, Livestock, Mixed']
  main_activity varchar(255)
  area_feddan decimal(12,2) [not null]
  governorate varchar(120) [not null]
  area_name varchar(120)
  public_map_latitude decimal(10,8) [note: 'Coarse/approved public location only, never precise private coordinates']
  public_map_longitude decimal(11,8) [note: 'Coarse/approved public location only']
  private_pin_latitude decimal(10,8)
  private_pin_longitude decimal(11,8)
  approximate_area text
  water_source varchar(40) [note: 'Well, Canal; business validation may extend']
  irrigation_method varchar(40) [note: 'Drip, Sprinkler, Gravity']
  energy_source varchar(40) [note: 'Electricity, Solar, Diesel']
  soil_type varchar(120)
  production_details json
  access_details json
  facilities json
  farm_status varchar(30) [not null, default: 'active']
  created_by bigint
  created_at datetime(3)
  updated_at datetime(3)
  deleted_at datetime(3)
  indexes {
    (governorate, area_name)
    (farm_type, area_feddan)
    (water_source, irrigation_method, energy_source)
    (farm_status)
  }
  Note: 'Exact farm coordinates are private; expose only public_map_* where explicitly approved. Facilities remain owner-stated unless reviewed.'
}

Table farm_relationships {
  id bigint [pk, increment]
  user_id bigint [not null]
  farm_id bigint [not null]
  relationship_role varchar(40) [not null, note: 'owner, partner, manager, agricultural_engineer, tenant']
  relationship_status varchar(20) [not null, default: 'active', note: 'active, pending, inactive']
  starts_at datetime(3)
  ends_at datetime(3)
  created_at datetime(3)
  indexes {
    (farm_id, user_id, relationship_role) [unique]
    (user_id, relationship_role)
    (farm_id, relationship_role)
  }
  Note: 'This is the source of contextual farm roles. Buyer/renter are not global roles.'
}

// Crop categories are multi-valued; values must follow the approved marketplace taxonomy.
Table farm_crop_types {
  id bigint [pk, increment]
  farm_id bigint [not null]
  crop_type varchar(80) [not null]
  created_at datetime(3)
  indexes {
    (farm_id, crop_type) [unique]
    (crop_type, farm_id)
  }
  Note: 'Only record crop types actually stated by the owner or reviewed from farm data; no inferred tags.'
}

Table farm_media {
  id bigint [pk, increment]
  farm_id bigint [not null]
  uploaded_by bigint [not null]
  media_type varchar(30) [not null, note: 'photo, video, plan']
  storage_key varchar(500) [not null]
  alt_en varchar(255)
  alt_ar varchar(255)
  width int
  height int
  focal_x decimal(5,4)
  focal_y decimal(5,4)
  is_illustrative boolean [not null, default: false]
  licence_status varchar(30) [not null, default: 'pending_confirmation']
  sort_order int [not null, default: 0]
  created_at datetime(3)
}

// =========================
// UNIFIED REQUEST WORKFLOW
// =========================
Table requests {
  id bigint [pk, increment]
  request_number varchar(40) [unique, not null]
  request_type varchar(40) [not null, note: 'farm_listing, farm_management, partnership, professional_verification, professional_application, partnership_application, farm_details, farm_purchase_proposal']
  created_by bigint [not null]
  farm_id bigint
  parent_request_id bigint
  status varchar(50) [not null, default: 'draft']
  visibility varchar(20) [not null, default: 'private', note: 'private, public']
  current_step smallint [not null, default: 1]
  submitted_at datetime(3)
  published_at datetime(3)
  closed_at datetime(3)
  created_at datetime(3)
  updated_at datetime(3)
  indexes {
    (request_type, status, published_at)
    (created_by, created_at)
    (farm_id, request_type, status)
    (parent_request_id, request_type, status)
  }
  Note: 'Root requests: farm_listing, farm_management, partnership, professional_verification. Child requests: professional_application -> management, partnership_application -> partnership, farm_details -> farm_listing, farm_purchase_proposal -> farm_listing. Purchase proposals are user intents reviewed/relayed by FarmExit; they are NOT payments or binding on-platform contracts.'
}

Table farm_listing_details {
  request_id bigint [pk]
  slug varchar(220) [unique, not null]
  listing_type varchar(10) [not null, note: 'sale, rent']
  asking_price decimal(15,2)
  annual_rent_per_feddan decimal(15,2)
  stated_sale_price_per_feddan decimal(15,2) [note: 'Optional owner-stated/reviewed value; do not fabricate when absent']
  currency char(3) [not null, default: 'EGP']
  availability varchar(60)
  listing_description text
  highlights json
  extra_details json
  indexes {
    (listing_type, asking_price)
    (listing_type, annual_rent_per_feddan)
    (availability)
  }
  Note: 'Sale uses asking_price; rent uses annual_rent_per_feddan. Never apply the EGP 5m-100m sale price filter to rent. Prices are listing information, not online payments. For SALE, use farm_sale_terms to disclose eligible purchase proposals. Missing values display Not stated in listing.'
}

Table farm_management_details {
  request_id bigint [pk]
  professional_need varchar(30) [not null, note: 'farmManager, agriculturalEngineer, both']
  management_types json
  term varchar(100)
  current_team json
  current_situation text
  challenges json
  goals json
  outcomes text
  responsibilities json
  experience_level varchar(30)
  crop_expertise json
  on_site_presence varchar(100)
  team_leadership varchar(100)
  resources_and_facilities json
  additional_information text
}

Table partnership_details {
  request_id bigint [pk]
  objective json
  description text
  accepted_partner_types json [note: 'individual, company']
  partner_background json
  looking_for json
  contribution_sought json
  contribution_details text
  current_team json
  operations text
  sales_channel varchar(255)
  extra_information text
  owner_documents_required json
  Note: 'No ROI, financial-return percentages or guarantees are stored as assumed business data.'
}

Table request_application_details {
  request_id bigint [pk]
  applicant_kind varchar(20) [note: 'individual, company; partnership applications only']
  professional_capability_id bigint [note: 'For professional applications, must point to a verified professional capability at submission time.']
  application_message text
  why_good_fit text
  relevant_experience text
  approach text
  working_style text
  additional_information text
  company_name varchar(200)
  company_registration_number varchar(100)
  company_contact_name varchar(150)
  company_contact_role varchar(100)
  company_sector varchar(150)
  proposal_details json
  Note: 'Company identity is captured as application snapshot; there is no separate company account/role.'
}

Table request_documents {
  id bigint [pk, increment]
  request_id bigint [not null]
  uploaded_by bigint [not null]
  slot_key varchar(60) [not null, note: 'Generic Required document 1..N until official names are approved']
  document_type varchar(120)
  original_name varchar(255)
  storage_key varchar(500) [not null]
  mime_type varchar(120)
  file_size_bytes bigint
  review_status varchar(30) [not null, default: 'uploaded', note: 'required, uploading, uploaded, under_review, changes_requested, approved, unsupported, rejected']
  reviewed_by bigint
  reviewed_at datetime(3)
  review_note text
  created_at datetime(3)
  indexes {
    (request_id, slot_key)
    (request_id, review_status)
  }
  Note: 'Private object-storage key; never expose the original applicant document directly to owners.'
}

Table request_reviews {
  id bigint [pk, increment]
  request_id bigint [not null]
  reviewer_id bigint [not null]
  decision varchar(30) [not null, note: 'approved, changes_requested, rejected']
  comment text
  created_at datetime(3)
}

Table request_status_history {
  id bigint [pk, increment]
  request_id bigint [not null]
  from_status varchar(50)
  to_status varchar(50) [not null]
  changed_by bigint [not null]
  reason text
  created_at datetime(3)
  indexes {
    (request_id, created_at)
  }
}

Table request_forwardings {
  id bigint [pk, increment]
  request_id bigint [not null]
  recipient_user_id bigint [not null]
  forwarded_by bigint [not null]
  status varchar(30) [not null, default: 'sent', note: 'sent, viewed, decided, closed']
  owner_decision varchar(30) [note: 'pending, accepted, declined']
  decision_reason text
  decided_by bigint
  created_at datetime(3)
  decided_at datetime(3)
  indexes {
    (request_id, recipient_user_id) [unique]
    (recipient_user_id, status)
  }
  Note: 'Used when FarmExit forwards an approved/reviewed application or details request to the farm owner. Owner decision is stored here with actor/time.'
}

Table request_staff_assignments {
  id bigint [pk, increment]
  request_id bigint [not null]
  assignment_type varchar(20) [not null, note: 'reviewer, case_agent']
  assigned_staff_id bigint [not null]
  assigned_by_user_id bigint [not null]
  assigned_at datetime(3) [not null]
  updated_at datetime(3) [not null]
  indexes {
    (request_id, assignment_type) [unique]
    (assigned_staff_id)
  }
  Note: 'Current FarmExit staff slot for a request. One reviewer and one case agent, kept independent. Not a communication case, not a review decision, and not a permission grant.'
}

// =========================
// SALE MODES & OWNER EXCHANGE PREFERENCES
// =========================
Table farm_sale_terms {
  listing_request_id bigint [pk, note: '1:1 with farm_listing_details; ONLY for listing_type=sale, never rent']
  sale_mode varchar(24) [not null, default: 'standard_cash', note: 'standard_cash or quick_sale']
  accepts_cash_proposals boolean [not null, default: true]
  accepts_installment_proposals boolean [not null, default: false]
  accepts_exchange_proposals boolean [not null, default: false]
  exchange_preference_scope varchar(20) [not null, default: 'any', note: 'any, selected; selected requires at least one preference row']
  updated_at datetime(3)
  indexes {
    (sale_mode, accepts_installment_proposals, accepts_exchange_proposals)
  }
  Note: 'Owner chooses standard_cash (cash offers only) or quick_sale (accepts receiving both installment and exchange proposals, as well as cash). These booleans represent eligibility to PROPOSE, NOT automatic acceptance of offer or guarantee of sale. Quick sale => accepts_installment_proposals=true AND accepts_exchange_proposals=true. Exchange scope=any means any supported asset type; selected means only owner-selected asset types in farm_exchange_preferences. A buyer may express interest in purchasing a partial share; this is not an owner-approved sale option or binding offer. Admins coordinate participants OUTSIDE the website. Negotiated installment terms and barter values are NOT payment records.'
}

Table farm_exchange_preferences {
  id bigint [pk, increment]
  listing_request_id bigint [not null]
  asset_type varchar(24) [not null, note: 'factory, villa, apartment, car; owner multiselect']
  created_at datetime(3)
  indexes {
    (listing_request_id, asset_type) [unique]
    (asset_type, listing_request_id)
  }
  Note: 'Eligible only when accepts_exchange_proposals is true. Public exchange multiselect filter matches listings with scope=any OR any intersecting selected asset type when scope=selected. It represents the asset category, not ownership or asset verification.'
}

// =========================
// BUYER PURCHASE PROPOSALS (NOT PAYMENTS)
// =========================
Table farm_purchase_proposal_details {
  request_id bigint [pk, note: 'Child requests.request_type=farm_purchase_proposal; parent_request_id must be a SALE farm_listing request']
  proposal_kind varchar(25) [not null, note: 'cash, installment, exchange, mixed, co_purchase']
  proposed_total_value decimal(15,2) [note: 'Buyer-declared estimated total offer, not funds paid or guaranteed asset valuation']
  currency char(3) [not null, default: 'EGP']
  requested_share_percent decimal(5,2) [note: 'Only for co_purchase; strictly greater than 0 and at most 100']
  proposal_notes text
  submitted_at datetime(3)
  Note: 'Buyer can propose cash, installment terms, exchange, cash+asset mixed consideration, or partial share ownership. FarmExit staff sees and mediates proposals via existing request_forwardings and private conversations. FarmExit staff handle any discussions and approvals outside the website; no on-platform owner acceptance is required or tracked for purchase proposals. No checkout, payment schedule execution or title transfer on the website.'
}

Table farm_purchase_proposal_components {
  id bigint [pk, increment]
  proposal_request_id bigint [not null]
  component_type varchar(30) [not null, note: 'cash, installments, exchange_asset']
  proposed_value decimal(15,2) [note: 'Buyer-estimated amount/value; never recorded as paid or receivable']
  currency char(3) [not null, default: 'EGP']
  asset_type varchar(24) [note: 'Required if exchange_asset: factory, villa, apartment, car']
  asset_description text [note: 'Buyer describes the offered item; optional supporting docs live in request_documents']
  installment_count int [note: 'Only if installments; proposed, subject to negotiation with FarmExit/admin and seller']
  installment_interval varchar(50) [note: 'Optional proposed interval, subject to agreement, not an executable payment schedule']
  component_notes text
  created_at datetime(3)
  indexes {
    (proposal_request_id, component_type)
    (component_type, asset_type)
  }
  Note: 'Supports examples such as EGP 5m proposed cash plus a car estimated at EGP 5m. Exchange assets may be multiple. Installment proposals are commercial terms only, never payment transactions. Match offered asset types to owner preferences before forwarding. Verify listing allows each proposed method.'
}

// =========================
// CO-PURCHASE MATCHING, STAFF-COORDINATED
// =========================
Table co_purchase_groups {
  id bigint [pk, increment]
  listing_request_id bigint [not null, note: 'SALE listing only']
  assigned_staff_id bigint [not null, note: 'FarmExit staff member who coordinates buyers and owner']
  target_share_percent decimal(5,2) [not null, default: 100.00, note: 'Nonbinding matching target only; 100% does not establish an agreed deal']
  listing_asking_price_snapshot decimal(15,2) [note: 'Information-only asking price at group creation, not amount collected']
  group_status varchar(35) [not null, default: 'collecting_interest', note: 'collecting_interest, under_staff_followup, closed; internal lead coordination only']
  notes text
  created_at datetime(3)
  updated_at datetime(3)
  closed_at datetime(3)
  indexes {
    (listing_request_id, group_status)
    (assigned_staff_id, group_status)
  }
  Note: 'Internal shortlist of buyers interested in partial shares of the SAME sale listing. FarmExit staff can contact them outside the website. No group approval/acceptance or sale-closing workflow exists in the platform. Reaching 100% is only a nonbinding match indicator; legal negotiations, seller consent, pricing and completion are all handled externally.'
}

Table co_purchase_group_members {
  id bigint [pk, increment]
  group_id bigint [not null]
  buyer_proposal_request_id bigint [not null, note: 'Must reference a co_purchase farm_purchase_proposal under the same listing; not a buyer approved to transact']
  proposed_share_percent decimal(5,2) [not null, note: 'Buyer requested share: >0 and <=100; interest only, not ownership allocation']
  proposed_contribution_value decimal(15,2) [note: 'Buyer proposed contribution or off-platform negotiated figure; NOT payment collected']
  member_status varchar(30) [not null, default: 'candidate', note: 'candidate, shortlisted, withdrawn, archived; internal matching only']
  created_at datetime(3)
  updated_at datetime(3)
  indexes {
    (group_id, buyer_proposal_request_id) [unique]
    (group_id, member_status)
    (buyer_proposal_request_id)
  }
  Note: 'Each member is a nonbinding buyer interest linked to a purchase proposal, not an ownership share, buyer approval, or payment account. Multiple candidates may express overlapping interests, so do NOT require all candidate percentages to sum to <=100. Staff may shortlist a potential combination for external coordination. No buyer-to-buyer contact details are shared and there is no on-platform confirmation or completion.'
}

// =========================
// FARMEXIT EVALUATIONS / SCORES (NOT CUSTOMER RATINGS)
// =========================
Table farm_evaluations {
  id bigint [pk, increment]
  farm_id bigint [not null]
  listing_request_id bigint [note: 'Optional listing scope; must reference a farm_listing request for the same farm']
  reviewed_by bigint [not null, note: 'Authorized FarmExit staff reviewer']
  approved_by bigint [note: 'Authorized FarmExit staff approver']
  score_value decimal(7,2) [note: 'Nullable until a documented scoring policy authorizes calculation']
  score_max decimal(7,2) [note: 'Explicit scale, e.g. 5 or 100; never assume scale']
  methodology_name varchar(150)
  methodology_version varchar(60)
  review_scope_en text [note: 'Only describe checks actually completed']
  review_scope_ar text
  public_summary_en text
  public_summary_ar text
  internal_notes text
  status varchar(30) [not null, default: 'draft', note: 'draft, in_review, approved, published, withdrawn, superseded']
  reviewed_at datetime(3)
  approved_at datetime(3)
  published_at datetime(3)
  created_at datetime(3)
  updated_at datetime(3)
  indexes {
    (farm_id, status, published_at)
    (listing_request_id, status)
    (reviewed_by, created_at)
  }
  Note: 'Only FarmExit staff produces evaluations; NOT user reviews, not a blanket Verified badge. Preserve history. Public score is allowed only for an authorized published evaluation with an approved documented methodology and factual review scope; score_value must be within 0..score_max. Do not publish fictional sample scores as actual evaluations.'
}

Table farm_evaluation_checks {
  id bigint [pk, increment]
  evaluation_id bigint [not null]
  check_key varchar(120) [not null, note: 'Approved criterion key; do not pre-populate hypothetical scoring criteria']
  check_status varchar(30) [not null, default: 'not_reviewed', note: 'not_reviewed, reviewed, needs_information']
  evidence_document_id bigint [note: 'Optional reviewed request document. Authorization required.']
  reviewer_notes text
  reviewed_at datetime(3)
  indexes {
    (evaluation_id, check_key) [unique]
  }
  Note: 'Tracks documented review scope/evidence without inventing criterion weights or formula.'
}

// =========================
// PROFESSIONAL EXPERIENCE
// =========================
Table professional_profiles {
  id bigint [pk, increment]
  user_id bigint [unique, not null]
  headline varchar(255)
  bio text
  base_governorate varchar(120)
  years_experience smallint
  experience_summary text
  working_preferences json
  created_at datetime(3)
  updated_at datetime(3)
}

Table professional_capabilities {
  id bigint [pk, increment]
  professional_profile_id bigint [not null]
  professional_type varchar(40) [not null, note: 'farm_manager, agricultural_engineer']
  verification_status varchar(30) [not null, default: 'verification_required', note: 'verification_required, draft, under_review, changes_requested, verified, not_approved']
  verified_at datetime(3)
  not_approved_reason text
  indexes {
    (professional_profile_id, professional_type) [unique]
  }
  Note: 'Farm Manager and Agricultural Engineer are verified independently. No Agricultural Specialist.'
}

Table professional_expertise {
  id bigint [pk, increment]
  professional_capability_id bigint [not null]
  expertise_type varchar(80) [not null]
  expertise_value varchar(150) [not null]
  created_at datetime(3)
  indexes {
    (professional_capability_id, expertise_type, expertise_value) [unique]
  }
}

Table professional_service_areas {
  id bigint [pk, increment]
  professional_capability_id bigint [not null]
  governorate varchar(120) [not null]
  created_at datetime(3)
  indexes {
    (professional_capability_id, governorate) [unique]
  }
}

Table professional_verification_details {
  request_id bigint [pk]
  professional_capability_id bigint [not null]
  profile_snapshot json [not null]
  verification_summary text
  created_at datetime(3)
}

// =========================
// COMMUNICATION - FARMEXIT RELAY ONLY
// =========================
Table communication_cases {
  id bigint [pk, increment]
  request_id bigint [not null]
  assigned_staff_id bigint [not null]
  status varchar(30) [not null, default: 'open', note: 'open, waiting_customer, waiting_owner, closed']
  created_at datetime(3)
  closed_at datetime(3)
  indexes {
    (request_id, status)
    (assigned_staff_id, status)
  }
}

Table conversations {
  id bigint [pk, increment]
  case_id bigint [not null]
  external_user_id bigint [not null]
  status varchar(20) [not null, default: 'open']
  created_at datetime(3)
  closed_at datetime(3)
  indexes {
    (case_id, external_user_id) [unique]
  }
  Note: 'One external user per channel. No direct buyer/renter <-> owner conversation exists.'
}

Table messages {
  id bigint [pk, increment]
  conversation_id bigint [not null]
  sender_id bigint [not null]
  body text
  sent_at datetime(3)
  edited_at datetime(3)
  deleted_at datetime(3)
  indexes {
    (conversation_id, sent_at)
  }
  Note: 'Sender must be either the channel external user or an authorized FarmExit staff member.'
}

Table message_relays {
  id bigint [pk, increment]
  source_message_id bigint [not null]
  relayed_message_id bigint [unique, not null]
  relayed_by bigint [not null]
  relay_note text
  relayed_at datetime(3)
  Note: 'Explicit audit trail: customer message -> FarmExit review -> new FarmExit-authored message to the other side.'
}

Table message_attachments {
  id bigint [pk, increment]
  message_id bigint [not null]
  storage_key varchar(500) [not null]
  mime_type varchar(120)
  file_size_bytes bigint
  created_at datetime(3)
}

Table message_reads {
  message_id bigint [not null]
  user_id bigint [not null]
  read_at datetime(3) [not null]
  indexes {
    (message_id, user_id) [pk]
  }
}

// =========================
// SAVED ITEMS
// =========================
Table saved_items {
  id bigint [pk, increment]
  user_id bigint [not null]
  item_type varchar(40) [not null, note: 'farm, management_opportunity, partnership_opportunity, listing']
  target_key varchar(100) [not null, note: 'Stable kind:id key, e.g. farm:12, management_opportunity:45, or listing:45, to enforce uniqueness despite nullable foreign keys']
  farm_id bigint
  opportunity_request_id bigint
  listing_request_id bigint [note: 'Set only for item_type=listing. A published farm listing request, independent of a farm bookmark.']
  saved_at datetime(3)
  indexes {
    (user_id, target_key) [unique]
    (user_id, listing_request_id) [unique]
    (user_id, farm_id)
    (user_id, opportunity_request_id)
    (user_id, item_type, saved_at)
  }
  Note: 'Exactly one target. farm: farm_id. management/partnership: opportunity_request_id. listing: listing_request_id. The other targets are null. UNIQUE(user_id, target_key) and UNIQUE(user_id, listing_request_id) prevent duplicate saves. MySQL allows many null listing_request_id values, so farm and opportunity bookmarks are unchanged.'
}

// =========================
// SITE VISITS & OFF-PLATFORM OUTCOME TRACKING
// =========================
Table site_visits {
  id bigint [pk, increment]
  request_id bigint [not null]
  farm_id bigint [not null]
  arranged_by bigint [not null]
  visitor_user_id bigint [not null]
  scheduled_at datetime(3)
  status varchar(30) [not null, default: 'proposed', note: 'proposed, scheduled, completed, cancelled']
  notes text
  created_at datetime(3)
}

Table request_outcomes {
  id bigint [pk, increment]
  request_id bigint [unique, not null]
  recorded_by bigint [not null, note: 'Authorized FarmExit staff user']
  outcome_type varchar(50) [not null, note: 'sale_completed_off_platform, rent_completed_off_platform, no_deal, withdrawn, other']
  confirmation_status varchar(30) [not null, default: 'reported', note: 'reported, confirmed, disputed, corrected']
  occurred_at datetime(3) [note: 'Date reported by parties; not proof of legal transfer or payment']
  recorded_at datetime(3)
  confirmed_by bigint
  confirmed_at datetime(3)
  internal_notes text
  updated_at datetime(3)
  indexes {
    (outcome_type, recorded_at)
    (confirmation_status, recorded_at)
  }
  Note: 'OPTIONAL staff-entered historic summary when FarmExit learns an external sale/rent outcome. Not a required stage of proposal, co-purchase grouping or publication. No in-app deal approval, contract, payment, invoice, commission accrual, balances, settlement, or guarantees. This record does not prove legal ownership transfer or payment.'
}

// =========================
// AGRICULTURAL FACILITIES & FACTORIES
// =========================
Table agricultural_facilities {
  id bigint [pk, increment]
  owner_user_id bigint [not null]
  farm_id bigint
  facility_type varchar(80) [not null, note: 'cold_storage_freezing, produce_storage, agricultural_processing_packing, agricultural_service_facility; draft taxonomy pending validation']
  name varchar(200) [not null]
  description text
  governorate varchar(120)
  area_name varchar(120)
  latitude decimal(10,8)
  longitude decimal(11,8)
  capacity_details json
  services json
  status varchar(30) [not null, default: 'draft', note: 'draft, under_review, approved, published, rejected, archived']
  created_at datetime(3)
  updated_at datetime(3)
  deleted_at datetime(3)
  Note: 'Future-ready capability requested by the client; detailed UI/business rules are still pending validation.'
}

Table facility_media {
  id bigint [pk, increment]
  facility_id bigint [not null]
  uploaded_by bigint [not null]
  storage_key varchar(500) [not null]
  media_type varchar(30) [not null, default: 'photo']
  alt_en varchar(255)
  alt_ar varchar(255)
  sort_order int [not null, default: 0]
  licence_status varchar(30) [not null, default: 'pending_confirmation']
  created_at datetime(3)
}

// =========================
// NOTIFICATIONS / AUDIT
// =========================
Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  request_id bigint
  notification_type varchar(60) [not null]
  title varchar(200) [not null]
  body text
  actionable boolean [not null, default: false]
  read_at datetime(3)
  created_at datetime(3)
  indexes {
    (user_id, read_at, created_at)
    (request_id)
  }
}

Table audit_logs {
  id bigint [pk, increment]
  actor_user_id bigint
  entity_type varchar(80) [not null]
  entity_id bigint [not null]
  action varchar(60) [not null]
  changes json
  ip_address varchar(45)
  created_at datetime(3)
  indexes {
    (entity_type, entity_id, created_at)
    (actor_user_id, created_at)
  }
}

