Ref: professional_verification_details.professional_capability_id > professional_capabilities.id

Ref: communication_cases.request_id > requests.id
Ref: communication_cases.assigned_staff_id > users.id
Ref: conversations.case_id > communication_cases.id
Ref: conversations.external_user_id > users.id
Ref: messages.conversation_id > conversations.id
