# FarmExit public website
# FarmExit API (use 4001 if port 4000 is occupied by another app, e.g. ore-care-backend)
# FARMEXIT_API_URL=http://127.0.0.1:4001/api/v1
FARMEXIT_API_URL=https://farmexit.nodeteam.site/api/v1
# Browser Socket.IO origin (optional; derived from NEXT_PUBLIC_FARMEXIT_API_URL if set)
# NEXT_PUBLIC_FARMEXIT_REALTIME_ORIGIN=http://127.0.0.1:4001
# NEXT_PUBLIC_FARMEXIT_API_URL=http://127.0.0.1:4001/api/v1
NEXT_PUBLIC_FARMEXIT_API_URL=https://farmexit.nodeteam.site/api/v1
# Official FarmExit WhatsApp (E.164 digits only, no +). Omit to hide the floating button.
# NEXT_PUBLIC_FARMEXIT_WHATSAPP_NUMBER=201000000000
# Visual-only demo button when number is not set (no wa.me link).
# NEXT_PUBLIC_FARMEXIT_WHATSAPP_PLACEHOLDER=true
# UX hint for demo sign-in mobiles only (must mirror server CLIENT_DEMO_OTP_ALLOWED_MOBILES).
# NEXT_PUBLIC_CLIENT_DEMO_OTP_HINT_MOBILES=+201099887701,+201099887702
