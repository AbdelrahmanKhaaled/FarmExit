{
  "name": "farmexit-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && node scripts/check-direction.mjs && node scripts/check-messages.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "node scripts/build-tokens.mjs && prettier --write src/styles/tokens.css src/styles/token-manifest.generated.ts",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --test src/features/my-messages/message-merge.test.ts src/features/my-messages/message-scroll.test.ts src/features/my-farmexit/unified-requests.test.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
